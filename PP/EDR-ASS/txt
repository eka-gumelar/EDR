            { lisensi: "AS0001", pass: "1000SA", nama: "Abdul", line: "Line 2", shift: "A", last_edited: "2024-05-01" },
            { lisensi: "AS0002", pass: "2000SA", nama: "Cantika", line: "Line 1", shift: "B", last_edited: "2024-05-01" }

            { no_assy: "0005695-010", cct: 123, umh: 282, last_edited: "2024-05-01" }
        ];

        let masterDataMP = [
            { id: "A001", nama: "Rita Juantina", join_date: "2023-08-14", shift: "A", last_edited: "2024-05-01" },
            { id: "A002", nama: "Chandra Hizbullah", join_date: "2022-06-27", shift: "A", last_edited: "2024-05-01" },
            { id: "A003", nama: "Abdul Azis", join_date: "2021-12-27", shift: "B", last_edited: "2024-05-01" },
            { id: "A004", nama: "Hilal Abiyyu", join_date: "2021-07-14", shift: "B", last_edited: "2024-05-01" }
